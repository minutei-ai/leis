  "arvore_textual": {
    "headline": "Emenda Constitucional nº 1, de 31 de março de 1992",
    "id": "https://normas.leg.br/?urn=urn:lex:br:federal:emenda.constitucional:1992-03-31;1",
    "articles": [
      {
        "dispositivo": "Art. 1º",
        "segments": [
          {
            "tipo": "texto",
            "texto": "O <span xmlns=\"http://www.lexml.gov.br/1.0\" xlink:href=\"urn:lex:br:federal:constituicao:1988-10-05;1988!art27_par2\">§ 2º do art. 27 da Constituição</span> passa a vigorar com a seguinte redação:",
            "id": "urn:lex:br:federal:emenda.constitucional:1992-03-31;1@1992-03-31!art1_cpt"
          },
          {
            "tipo": "rotulo",
            "texto": "Art. 27.",
            "id": "urn:lex:br:federal:emenda.constitucional:1992-03-31;1@1992-03-31!art1_cpt_alt1_art27"
          },
          {
            "tipo": "texto",
            "texto": "...............................................",
            "id": "urn:lex:br:federal:emenda.constitucional:1992-03-31;1@1992-03-31!art1_cpt_alt1_art27_cpt"
          },
          {
            "tipo": "texto",
            "texto": "...............................................",
            "id": "urn:lex:br:federal:emenda.constitucional:1992-03-31;1@1992-03-31!art1_cpt_alt1_art27_omi1"
          },
          {
            "tipo": "rotulo",
            "texto": "§ 2º",
            "id": "urn:lex:br:federal:emenda.constitucional:1992-03-31;1@1992-03-31!art1_cpt_alt1_art27_par2"
          },
          {
            "tipo": "texto",
            "texto": "A remuneração dos Deputados Estaduais será fixada em cada legislatura, para a subseqüente, pela Assembléia Legislativa, observado o que dispõem os arts. 150, II, 153, III, e 153, § 2º, I, na razão de, no máximo, setenta e cinco por cento daquela estabelecida, em espécie, para os Deputados Federais.",
            "id": "urn:lex:br:federal:emenda.constitucional:1992-03-31;1@1992-03-31!art1_cpt_alt1_art27_par2"
          },
          {
            "tipo": "texto",
            "texto": "...............................................",
            "id": "urn:lex:br:federal:emenda.constitucional:1992-03-31;1@1992-03-31!art1_cpt_alt1_art27_omi2"
          }
        ]
      },
      {
        "dispositivo": "Art. 2º",
        "segments": [
          {
            "tipo": "texto",
            "texto": "São acrescentados ao <span xmlns=\"http://www.lexml.gov.br/1.0\" xlink:href=\"urn:lex:br:federal:constituicao:1988-10-05;1988!art29\">art. 29 da Constituição</span> os seguintes incisos, VI e VII, renumerando-se os demais:",
            "id": "urn:lex:br:federal:emenda.constitucional:1992-03-31;1@1992-03-31!art2_cpt"
          },
          {
            "tipo": "rotulo",
            "texto": "Art. 29.",
            "id": "urn:lex:br:federal:emenda.constitucional:1992-03-31;1@1992-03-31!art2_cpt_alt1_art29"
          },
          {
            "tipo": "texto",
            "texto": "...............................................",
            "id": "urn:lex:br:federal:emenda.constitucional:1992-03-31;1@1992-03-31!art2_cpt_alt1_art29_cpt"
          },
          {
            "tipo": "rotulo",
            "texto": "VI –",
            "id": "urn:lex:br:federal:emenda.constitucional:1992-03-31;1@1992-03-31!art2_cpt_alt1_art29_cpt_inc6"
          },
          {
            "tipo": "texto",
            "texto": "a remuneração dos Vereadores corresponderá a, no máximo, setenta e cinco por cento daquela estabelecida, em espécie, para os Deputados Estaduais, ressalvado o que dispõe o <span xmlns:lx=\"http://www.lexml.gov.br/1.0\" xlink:href=\"urn:lex:br:federal:constituicao:1988-10-05;1988!art37_cpt_inc11\">art. 37, XI</span>;",
            "id": "urn:lex:br:federal:emenda.constitucional:1992-03-31;1@1992-03-31!art2_cpt_alt1_art29_cpt_inc6"
          },
          {
            "tipo": "rotulo",
            "texto": "VII –",
            "id": "urn:lex:br:federal:emenda.constitucional:1992-03-31;1@1992-03-31!art2_cpt_alt1_art29_cpt_inc7"
          },
          {
            "tipo": "texto",
            "texto": "o total da despesa com a remuneração dos Vereadores não poderá ultrapassar o montante de cinco por cento da receita do Município.",
            "id": "urn:lex:br:federal:emenda.constitucional:1992-03-31;1@1992-03-31!art2_cpt_alt1_art29_cpt_inc7"
          },
          {
            "tipo": "texto",
            "texto": "...............................................",
            "id": "urn:lex:br:federal:emenda.constitucional:1992-03-31;1@1992-03-31!art2_cpt_alt1_art29_omi1"
          }
        ]
      },
      {
        "dispositivo": "Art. 3º",
        "segments": [
          {
            "tipo": "texto",
            "texto": "Esta Emenda Constitucional entra em vigor na data de sua publicação.",
            "id": "urn:lex:br:federal:emenda.constitucional:1992-03-31;1@1992-03-31!art3_cpt"
          }
        ]
      }
    ]
  }
}
