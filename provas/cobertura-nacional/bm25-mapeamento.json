    }
  },
  "bool_query_exemplo": {
    "filter": [
      {
        "term": {
          "esfera": "federal"
        }
      },
      {
        "term": {
          "especie": "lei"
        }
      },
      {
        "prefix": {
          "data_ato": "2021"
        }
      },
      {
        "term": {
          "edicao_tipo": "historica"
        }
      }
    ],
    "must_not": [
      {
        "term": {
          "corpo_legal_integral_pendente": true
        }
      },
      {
        "term": {
          "excluir_denominador_integra": true
        }
      },
      {
        "term": {
          "texto_integral_pesquisavel": false
        }
      }
    ],
    "must": {
      "match": {
        "markdown_integral": "licitação pregão eletrônico"
      }
    }
  },
  "nota": "Nenhum índice Elasticsearch foi provisionado nesta entrega; o mapping e o BM25 in-process são demonstração offline."
}
